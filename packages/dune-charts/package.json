{
  "name": "@suveshmoza/dune-charts",
  "version": "0.0.1",
  "description": "Pixel-wave area, bar, line, and pie charts on a Recharts shell — themes, crest→depth fills, chunky cells",
  "keywords": [
    "area-chart",
    "bar-chart",
    "charts",
    "line-chart",
    "pie-chart",
    "pixel",
    "react",
    "recharts"
  ],
  "homepage": "https://github.com/suveshmoza/dune",
  "license": "MIT",
  "author": "Suvesh Moza <hellosuvesh@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/suveshmoza/dune-charts.git",
    "directory": "packages/dune-charts"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "prepublishOnly": "pnpm run build"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.2",
    "@tsdown/css": "^0.22.14",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "recharts": "^3.10.1",
    "tsdown": "^0.22.14",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "peerDependencies": {
    "react": "^18 || ^19",
    "react-dom": "^18 || ^19",
    "recharts": "^3"
  },
  "engines": {
    "node": ">=20"
  }
}
